# Normalize all text files to LF, both in the repository and in the working
# tree. Without this, files committed with CRLF conflict against upstream DDNet
# (LF) on every line, turning ordinary merges into whole-file conflicts.
# eol=lf keeps Windows checkouts LF too, so editors don't reintroduce CRLF.
* text=auto eol=lf

# Windows scripts need CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts need LF even on Windows.
*.sh text eol=lf

other/*/include/* linguist-vendored
src/engine/external/* linguist-vendored
