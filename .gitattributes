# Normalize all text files to LF in the repository. Git still checks them out
# with native line endings on Windows when core.autocrlf is enabled.
# Without this, files committed with CRLF conflict against upstream DDNet (LF)
# on every line, turning ordinary merges into whole-file conflicts.
* text=auto

# Windows scripts need CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts need LF even on Windows.
*.sh text eol=lf

other/*/include/* linguist-vendored
src/engine/external/* linguist-vendored
